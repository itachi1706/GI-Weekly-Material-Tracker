{
  "name": "gi-dataset-tool",
  "version": "0.0.1",
  "description": "Desktop dataset management tool for the GI Weekly Material Tracker",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "itachi1706",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:roundtrip": "node scripts/roundtrip-test.ts",
    "test:materials": "node scripts/materials-commit-test.ts",
    "normalize:format": "node scripts/normalize-format.ts",
    "validate": "node scripts/validate-dataset.ts",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "dist": "npm run build:mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
